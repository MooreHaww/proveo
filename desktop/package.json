{
  "name": "proveo-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Desktop shell for Proveo: runs eco_server.py locally and shows it in a window.",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "test": "node --test",
    "dist": "..\\.venv\\Scripts\\python.exe ../build_backend.py && electron-builder --win nsis --x64"
  },
  "devDependencies": {
    "electron": "45.2.1",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "proveo.app",
    "productName": "Proveo",
    "electronDist": "node_modules/electron/dist",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "lib.js",
      "preload.js"
    ],
    "extraResources": [
      {
        "from": "../build/proveo-backend",
        "to": "backend"
      },
      {
        "from": "../assets",
        "to": "assets",
        "filter": [
          "icon.ico",
          "icon.png"
        ]
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "../assets/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  }
}
